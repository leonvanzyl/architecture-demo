{
  "name": "house3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Data-driven walkable 3D house viewer (Three.js) built from a JSON plan spec",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && node scripts/inline-dist.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "validate": "node scripts/validate.mjs",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "playwright-core": "*",
    "vite": "*"
  }
}
